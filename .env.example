# Catalog API — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Environment
SPRING_PROFILES_ACTIVE=dev

# Database — defaults work with docker compose
DATABASE_URL=jdbc:postgresql://localhost:5432/catalog_db
DATABASE_USERNAME=catalog_user
DATABASE_PASSWORD=catalog_pass

# JWT — generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here_must_be_at_least_256_bits_long

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# ═══════════════════════════════════════════════
# Barcode Lookup Providers (all optional — providers skip when blank)
# ═══════════════════════════════════════════════

# Best Buy — register at developer.bestbuy.com
BEST_BUY_API_KEY=

# Google Books — console.cloud.google.com → APIs → Books API
GOOGLE_BOOKS_API_KEY=

# MusicBrainz — just your contact email for User-Agent header
MUSICBRAINZ_CONTACT_EMAIL=

# eBay Browse — register at developer.ebay.com
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# TMDB (movie/TV posters) — themoviedb.org → Settings → API
TMDB_API_KEY=

# IGDB (game covers) — register at dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
